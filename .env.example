# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/fi_money_assistant"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here"

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info

# AI Service Configuration
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4"

# Google AI Configuration (alternative)
GOOGLE_API_KEY="your-google-api-key-here"

# Fi Money API Configuration
FI_MONEY_API_KEY="your-fi-money-api-key-here"
FI_MONEY_API_URL="https://api.fimoney.com"

# Plaid Configuration (if using Plaid for financial data)
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret"
PLAID_ENV="sandbox"

# Security Configuration
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for notifications)
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# Redis Configuration (for caching)
REDIS_URL="redis://localhost:6379"

# Webhook Configuration
WEBHOOK_SECRET="your-webhook-secret"

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# Monitoring Configuration
SENTRY_DSN="your-sentry-dsn"
DATADOG_API_KEY="your-datadog-api-key"